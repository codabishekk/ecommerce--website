# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# OTP Server
OTP_PORT=4001

# MongoDB (Atlas SRV string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<cluster>

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRE=7d

# Gmail SMTP (OTP Email)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Fast2SMS (OTP SMS)
FAST2SMS_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AI Customer Support Agent ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536

# MongoDB Atlas Vector Search index name (created in Atlas UI on knowledgechunks)
ATLAS_VECTOR_INDEX=default
# Minimum cosine similarity before a retrieved chunk is sent to the LLM
RAG_MIN_SCORE=0.25
